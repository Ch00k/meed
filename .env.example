# SMTP Configuration
# Examples for Gmail:
#   MEED_SMTP_HOST=smtp.gmail.com
#   MEED_SMTP_PORT=587
MEED_SMTP_HOST=127.0.0.1
MEED_SMTP_PORT=25
MEED_SMTP_USER=user
MEED_SMTP_PASSWORD=password

# Email Configuration
MEED_EMAIL_FROM=meed@example.com
MEED_EMAIL_TO=my@e.mail

# Schedule Configuration
# Cron expression (default: every 4 hours)
MEED_CRON_SCHEDULE=0 */4 * * *
# Timezone for scheduling (default: UTC)
MEED_TIMEZONE=UTC

# IMAP Configuration (optional - for adding feeds via email)
# For Fastmail: MEED_IMAP_HOST=imap.fastmail.com
# MEED_IMAP_HOST=127.0.0.1
# MEED_IMAP_PORT=993
# MEED_IMAP_USER=your-email@fastmail.com
# MEED_IMAP_PASSWORD=your-app-password
# MEED_IMAP_MAILBOX=INBOX.meed

# Optional: Sentry error tracking
# MEED_SENTRY_DSN=

# File paths (usually don't need to change these)
# MEED_FEEDS_FILE_PATH=feeds.txt
# MEED_STATE_DB_PATH=state.db
